<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="5dp" >

    <!-- ============ Contact list (shown first) ============ -->
    <LinearLayout
        android:id="@+id/contactListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingTop="34dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="16dp"
            android:text="Phone"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#111111"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="8dp"
            android:text="RECENT"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:textColor="#999999"/>

        <LinearLayout
            android:id="@+id/helplineContactRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <androidx.cardview.widget.CardView
                android:layout_width="46dp"
                android:layout_height="46dp"
                app:cardCornerRadius="23dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F1E4EF">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Call"
                    android:textSize="12sp"
                    android:gravity="center"/>

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="eSehat Helpline"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#111111"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1800-300-4567 · Mobile"
                    android:textSize="13sp"
                    android:textColor="#888888"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="22sp"
                android:textColor="#CCCCCC"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="20dp"
            android:background="#EEEEEE"/>

    </LinearLayout>


    <!-- ============ Call screen (hidden until contact tapped) ============ -->
    <RelativeLayout
        android:id="@+id/callScreenView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_phone"
        android:visibility="gone"
        android:paddingTop="50dp"
        android:paddingBottom="40dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:id="@+id/callHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tvCallStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Incoming Call…"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:alpha="0.8"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="eSehat Helpline"
                android:textColor="#FFFFFF"
                android:textSize="30sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mobile · 1800-300-4567"
                android:textColor="#FFFFFF"
                android:alpha="0.7"
                android:textSize="15sp"/>

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_below="@id/callHeader"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="30dp"
            app:cardCornerRadius="75dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#33FFFFFF">

            <androidx.cardview.widget.CardView
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                app:cardCornerRadius="65dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#8A4B9C"/>

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/controlsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/actionButtons"
            android:layout_marginBottom="30dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <androidx.cardview.widget.CardView android:layout_width="50dp" android:layout_height="50dp" app:cardCornerRadius="25dp" app:cardElevation="0dp" app:cardBackgroundColor="#22FFFFFF">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="+" android:textColor="#FFFFFF" android:textSize="20sp" android:gravity="center"/>
                    </androidx.cardview.widget.CardView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Add call" android:textColor="#FFFFFF" android:alpha="0.8" android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <androidx.cardview.widget.CardView android:layout_width="50dp" android:layout_height="50dp" app:cardCornerRadius="25dp" app:cardElevation="0dp" app:cardBackgroundColor="#22FFFFFF">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="||" android:textColor="#FFFFFF" android:textSize="14sp" android:gravity="center"/>
                    </androidx.cardview.widget.CardView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Hold call" android:textColor="#FFFFFF" android:alpha="0.8" android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <androidx.cardview.widget.CardView android:layout_width="50dp" android:layout_height="50dp" app:cardCornerRadius="25dp" app:cardElevation="0dp" app:cardBackgroundColor="#22FFFFFF">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="BT" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center"/>
                    </androidx.cardview.widget.CardView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Bluetooth" android:textColor="#FFFFFF" android:alpha="0.8" android:textSize="11sp"/>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <androidx.cardview.widget.CardView android:layout_width="50dp" android:layout_height="50dp" app:cardCornerRadius="25dp" app:cardElevation="0dp" app:cardBackgroundColor="#22FFFFFF">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="))" android:textColor="#FFFFFF" android:textSize="14sp" android:gravity="center"/>
                    </androidx.cardview.widget.CardView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Speaker" android:textColor="#FFFFFF" android:alpha="0.8" android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <androidx.cardview.widget.CardView android:layout_width="50dp" android:layout_height="50dp" app:cardCornerRadius="25dp" app:cardElevation="0dp" app:cardBackgroundColor="#22FFFFFF">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="Mic" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
                    </androidx.cardview.widget.CardView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Mute" android:textColor="#FFFFFF" android:alpha="0.8" android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/keypadToggle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
                    <androidx.cardview.widget.CardView android:layout_width="50dp" android:layout_height="50dp" app:cardCornerRadius="25dp" app:cardElevation="0dp" app:cardBackgroundColor="#59FFFFFF">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text=":::" android:textColor="#FFFFFF" android:textSize="14sp" android:gravity="center"/>
                    </androidx.cardview.widget.CardView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Keypad" android:textColor="#FFFFFF" android:alpha="0.8" android:textSize="11sp"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/answerBtn"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginEnd="40dp"
                app:cardCornerRadius="35dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#2ED573"
                android:clickable="true"
                android:focusable="true">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="Answer" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/endCallBtn"
                android:layout_width="70dp"
                android:layout_height="70dp"
                app:cardCornerRadius="35dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#EB4D4B"
                android:clickable="true"
                android:focusable="true">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="End" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/keypadDrawer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#F2140A1E"
            android:paddingTop="24dp"
            android:paddingBottom="30dp"
            android:visibility="gone">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                <Button android:id="@+id/key1" style="?android:attr/borderlessButtonStyle" android:layout_width="60dp" android:layout_height="60dp" android:text="1" android:textColor="#FFFFFF" android:textSize="22sp" android:background="#26FFFFFF"/>
                <Button android:id="@+id/key2" style="?android:attr/borderlessButtonStyle" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginStart="14dp" android:text="2" android:textColor="#FFFFFF" android:textSize="22sp" android:background="#26FFFFFF"/>
                <Button android:id="@+id/key3" style="?android:attr/borderlessButtonStyle" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginStart="14dp" android:text="3" android:textColor="#FFFFFF" android:textSize="22sp" android:background="#26FFFFFF"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                <Button android:id="@+id/key4" style="?android:attr/borderlessButtonStyle" android:layout_width="60dp" android:layout_height="60dp" android:text="4" android:textColor="#FFFFFF" android:textSize="22sp" android:background="#26FFFFFF"/>
                <Button android:id="@+id/key5" style="?android:attr/borderlessButtonStyle" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginStart="14dp" android:text="5" android:textColor="#FFFFFF" android:textSize="22sp" android:background="#26FFFFFF"/>
                <Button android:id="@+id/key6" style="?android:attr/borderlessButtonStyle" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginStart="14dp" android:text="6" android:textColor="#FFFFFF" android:textSize="22sp" android:background="#26FFFFFF"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                <Button android:id="@+id/key7" style="?android:attr/borderlessButtonStyle" android:layout_width="60dp" android:layout_height="60dp" android:text="7" android:textColor="#FFFFFF" android:textSize="22sp" android:background="#26FFFFFF"/>
                <Button android:id="@+id/key8" style="?android:attr/borderlessButtonStyle" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginStart="14dp" android:text="8" android:textColor="#FFFFFF" android:textSize="22sp" android:background="#26FFFFFF"/>
                <Button android:id="@+id/key9" style="?android:attr/borderlessButtonStyle" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginStart="14dp" android:text="9" android:textColor="#FFFFFF" android:textSize="22sp" android:background="#26FFFFFF"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="18dp">
                <Button android:id="@+id/keyStar" style="?android:attr/borderlessButtonStyle" android:layout_width="60dp" android:layout_height="60dp" android:text="*" android:textColor="#FFFFFF" android:textSize="22sp" android:background="#26FFFFFF"/>
                <Button android:id="@+id/key0" style="?android:attr/borderlessButtonStyle" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginStart="14dp" android:text="0" android:textColor="#FFFFFF" android:textSize="22sp" android:background="#26FFFFFF"/>
                <Button android:id="@+id/keyHash" style="?android:attr/borderlessButtonStyle" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginStart="14dp" android:text="#" android:textColor="#FFFFFF" android:textSize="22sp" android:background="#26FFFFFF"/>
            </LinearLayout>

            <TextView
                android:id="@+id/hideKeypadLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hide Keypad"
                android:textColor="#FFFFFF"
                android:alpha="0.6"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </RelativeLayout>

</FrameLayout>