<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C1320"
    android:paddingTop="20dp">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Multilingual Realtime Call"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Connecting…"
            android:textColor="#8899AA"
            android:textSize="13sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/et_room_code"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="#80FFFFFF"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="demo-room"
                android:textColor="@android:color/black"
                android:hint="Room code"
                android:singleLine="true"
                android:textSize="14sp"/>

            <Spinner
                android:id="@+id/spinner_language"
                android:layout_width="120dp"
                android:layout_height="44dp"
                android:background="#80FFFFFF"
                android:popupBackground="#1A2438"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Live captions / transcript -->
    <ScrollView
        android:id="@+id/scroll_transcript"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_bar"
        android:layout_above="@id/bottom_controls"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/tv_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp"/>

    </ScrollView>

    <!-- Bottom controls -->
    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="30dp"
        android:paddingTop="16dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/mic_indicator"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:cardCornerRadius="35dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#2E7D32">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="TALK"
                android:textSize="20sp"
                android:gravity="center"/>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_mic_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Listening…"
            android:textColor="#8899AA"
            android:textSize="12sp"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_end_call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E53935">

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</RelativeLayout>